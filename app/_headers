# I fotogrammi hanno nomi che dipendono dal loro contenuto e non cambiano mai. Restano nella cache
# del browser al massimo 30 giorni: chi non gioca per un po' non si ritrova spazio occupato.
/f/*
  Cache-Control: public, max-age=2592000, immutable

/game.json
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
